{
  "name": "manga-translate",
  "version": "0.1.0",
  "description": "Chrome extension to detect and translate manga panels with overlay translations",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch --mode development",
    "build": "node scripts/build.mjs --mode production",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "zip": "cd dist && zip -r ../manga-translate.zip ."
  },
  "dependencies": {
    "onnxruntime-web": "^1.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
